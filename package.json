{
  "name": "ai-news-feed",
  "version": "1.0.0",
  "description": "AI News & Intelligence Feed plugin for DeepSeek Harness (DSH)",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "ai-news",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/laowang5/ai-news-feed.git"
  },
  "homepage": "https://github.com/laowang5/ai-news-feed",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "industry",
    "icon.svg",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/check-client-bundle.mjs",
    "dev": "tsc --watch",
    "preview": "node scripts/preview-server.js",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=3.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "tsdown": "^0.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@extractus/feed-extractor": "^8.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
